#!/bin/sh

set -eu

compiler=gcc
target_dir=exe/compiled
pkg_cflags=$(pkg-config --cflags gtk4 gio-2.0 gdk-pixbuf-2.0 libopenraw-gnome-0.3)
pkg_libs=$(pkg-config --libs gtk4 gio-2.0 gdk-pixbuf-2.0 libopenraw-gnome-0.3)

mkdir -p "$target_dir"

$compiler \
  -std=c17 \
  -D_POSIX_C_SOURCE=200809L \
  -D_FILE_OFFSET_BITS=64 \
  -Wall -Wextra -Wfatal-errors \
  -fno-common -pthread -O2 -g \
  -Isrc/foreign -Isrc \
  $pkg_cflags \
  src/trout.c src/thumbnailer.c \
  -o "$target_dir/trout" \
  $pkg_libs
