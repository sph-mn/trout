#!/bin/sh

set -eu

compiler=gcc
target_dir=exe/compiled
pkg_cflags=$(pkg-config --cflags gtk4 gio-2.0 gdk-pixbuf-2.0 libopenraw-gnome-0.3)
pkg_libs=$(pkg-config --libs gtk4 gio-2.0 gdk-pixbuf-2.0 libopenraw-gnome-0.3)
options="-std=c17 -D_POSIX_C_SOURCE=200809L -D_FILE_OFFSET_BITS=64 -Wall -Wextra -Wfatal-errors -fno-common -pthread -O2 -g -Isrc/foreign -Isrc/trout -Isrc"

mkdir -p "$target_dir"

$compiler $options \
  $pkg_cflags \
  src/trout/trout.c src/trout/file_transfer.c src/trout/thumbnailer.c \
  -o "$target_dir/trout" \
  $pkg_libs

$compiler $options \
  $pkg_cflags \
  src/test/trout.c src/trout/file_transfer.c src/trout/thumbnailer.c \
  -o "$target_dir/test-trout" \
  $pkg_libs
